# ============================================================
# Files to ignore when uploading source to Cloud Build
# ============================================================
# IMPORTANT: frontend/public/outputs/ MUST be uploaded — it contains
# all pre-computed docking results that get baked into the container.
# ============================================================

# Node modules (reinstalled during Docker build)
frontend/node_modules/
node_modules/

# Git internals
.git/
.gitignore

# Heavy docs not needed at runtime
docs/
*.docx
*.xlsx
*.pptx
*.zip

# IDE and OS files
.vscode/
.idea/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Test files
tests/
*.test.*
*.spec.*
.pytest_cache/

# Agent/CI config
.claude/
.gemini/
.github/

# Dev-only files
evidence_pack_manifest.json
generate_context.py
MIGRATION_CONTEXT.md
PROJECT_ARCHITECTURE_CONTEXT.md
FIX_SUMMARY.md

# Large log files
*.log
*.mp4
*.pdf
